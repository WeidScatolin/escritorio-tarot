# Copie para atendimento.env (fora do git) e preencha
EVOLUTION_API_KEY=mesma_chave_do_evolution.env
EVOLUTION_INSTANCE=tarot
WEBHOOK_TOKEN=gere_algo_longo_e_aleatorio
NIM_API_KEY=sua_chave_nvapi
NIM_MODEL=google/gemma-4-31b-it
TRIGGER_PHRASES=quero uma leitura de tarot,quero minha leitura de tarot,quero fazer uma leitura de tarot,quero uma tiragem de tarot,quero fazer uma tiragem,tiragem de 3 cartas,quero uma leitura de cartas,quero que leia minhas cartas,quero jogar tarot,quero uma consulta de tarot,vi o anuncio do tarot,vi o anuncio de tarot,vim pelo anuncio do tarot,tarot do amor,leitura de tarot
BLOCKLIST=
# Gasto em anuncios (Meta, somente leitura). Deixe em branco para desligar.
# Os tres primeiros sao tudo-ou-nada.
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_SPEND_SINCE=
META_API_VERSION=v25.0
AD_SPEND_POLL_MINUTES=10
