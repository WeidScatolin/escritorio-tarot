# Copie para .env e preencha. NUNCA suba o .env para o git.
PORT=3100
EVOLUTION_URL=http://evolution-api:8080
EVOLUTION_API_KEY=troque
EVOLUTION_INSTANCE=tarot
# Token que vai na URL do webhook (gere algo longo e aleatorio)
WEBHOOK_TOKEN=troque
NIM_API_KEY=troque
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=google/gemma-4-31b-it
# Listas separadas por virgula
TRIGGER_PHRASES=
BLOCKLIST=
DB_PATH=./data/atendimento.db
# Segundos de silencio do cliente antes da IA responder (junta as mensagens seguidas). 0 desliga.
MESSAGE_DEBOUNCE_SECONDS=8
# Gasto em anuncios (Meta, somente leitura). Deixe em branco para desligar.
# Os tres primeiros sao tudo-ou-nada.
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_SPEND_SINCE=
META_API_VERSION=v25.0
AD_SPEND_POLL_MINUTES=10

# Publicacao do painel na Vercel (opcional). Os dois sao tudo-ou-nada.
PUBLISH_URL=
PUBLISH_SECRET=
PUBLISH_INTERVAL_SECONDS=60

# Leitura em audio (nota de voz). Desligado por padrao; se o audio falhar, a leitura vai em texto.
TTS_ENABLED=false
TTS_VOICE=pt-BR-FranciscaNeural
